[Unit]
Description=Alpaca options code agent
Documentation=https://github.com/vetertann/alpaca-options-agent
After=network-online.target
Wants=network-online.target
# A crash loop must not hammer Alpaca; give up after 5 restarts in 10 minutes.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=alpaca
Group=alpaca
WorkingDirectory=/opt/alpaca-agent
EnvironmentFile=/opt/alpaca-agent/.env
Environment=PYTHONPATH=/opt/alpaca-agent/src
Environment=PYTHONUNBUFFERED=1
Environment=ALPACA_CLI_PATH=/usr/local/bin/alpaca
Environment=ALPACA_CONFIG_DIR=/opt/alpaca-agent/.run/cli-config
ExecStart=/opt/alpaca-agent/.venv/bin/python -m agent.run \
    --profile ${AGENT_PROFILE} --mode ${AGENT_MODE} \
    --robust-risk-pct 0.25 --scenario-risk-pct 0.25 \
    --single-position-risk-pct 0.25 --total-premium-risk-pct 0.60 \
    --realised-loss-throttle-pct 0.25 --aligned-direction-risk-pct 0.25 \
    --build-target-risk-pct 0.20 --sizing-posture terminal_push \
    --run-dir /opt/alpaca-agent/.run

Restart=always
RestartSec=15

# The agent listens on nothing and writes only to its own run directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/alpaca-agent/.run
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1G
TasksMax=256

StandardOutput=append:/opt/alpaca-agent/.run/agent.log
StandardError=append:/opt/alpaca-agent/.run/agent.err

[Install]
WantedBy=multi-user.target
