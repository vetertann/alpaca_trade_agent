[Unit]
Description=Read-only Alpaca dev comparator panel
After=network-online.target alpaca-agent-dev.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=alpaca
Group=alpaca
WorkingDirectory=/opt/alpaca-agent-dev
Environment=PYTHONPATH=/opt/alpaca-agent-dev/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/alpaca-agent-dev/.venv/bin/python /opt/alpaca-agent-dev/scripts/panel.py \
    --run-dir /opt/alpaca-agent-dev/.run --host 0.0.0.0 --port 3002

Restart=always
RestartSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=256M
TasksMax=64

StandardOutput=append:/opt/alpaca-agent-dev/.run/panel.log
StandardError=append:/opt/alpaca-agent-dev/.run/panel.err

[Install]
WantedBy=multi-user.target
