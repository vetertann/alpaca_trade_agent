# Competition account — scored Mon Aug 31 09:30 ET through EOD Thu Sep 3.
# Never used for testing. The host uses all three; Alpaca tools use the key pair.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_ACCOUNT_ID=

# Nebius AI Studio — primary LLM provider (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# Featherless AI — secondary provider ($25 hackathon credits)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# OpenTelemetry -- agent traces to the OTel collector
COLLECTOR_HOST=
OTEL_SERVICE_NAME=alpaca_options_agent
# Content capture is off by default. Enabling it sends prompts, generated programs,
# reasoning, and tool arguments to the collector.
OTEL_CAPTURE_CONTENT=false
